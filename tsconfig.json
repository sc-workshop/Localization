{
    "extends": "@sc-workshop/neko-core/config",
    "compilerOptions": {
        "moduleDetection": "force",
        "module": "preserve",
        "moduleResolution": "bundler",
        "rootDir": "source/",
        "outDir": "build/",
        "isolatedDeclarations": true
    },
    "include": [
        "source/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}